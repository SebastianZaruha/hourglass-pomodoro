{
  "name": "@reloj/mobile",
  "version": "1.9.0",
  "private": true,
  "description": "App Expo / React Native de Hourglass Pomodoro (Android, iOS y web).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Sebastián Zaruha (https://github.com/SebastianZaruha)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianZaruha/reloj-de-arena.git",
    "directory": "apps/mobile"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:dev": "node ./scripts/variante.mjs development expo start",
    "android": "expo run:android",
    "android:dev": "node ./scripts/variante.mjs development expo run:android",
    "apk": "node ./scripts/variante.mjs production expo prebuild --no-install -p android && node ./scripts/variante.mjs production node ../../scripts/build-apk.mjs",
    "apk:dev": "node ./scripts/variante.mjs development expo prebuild --no-install -p android && node ./scripts/variante.mjs development node ../../scripts/build-apk.mjs",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "postinstall": "setup-skia-web public"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^27.1.0",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/crashlytics": "^27.1.0",
    "@reloj/core": "*",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.10",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
